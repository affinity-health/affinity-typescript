{
  "name": "@affinity-health/sdk",
  "version": "2.0.0-beta.0",
  "description": "Official TypeScript SDK for the Affinity API",
  "homepage": "https://docs.affinityrx.com/api",
  "bugs": {
    "url": "https://github.com/affinity-health/affinity-typescript/issues"
  },
  "license": "MIT",
  "author": "Affinity API Support <support@affinityrx.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/affinity-health/affinity-typescript.git"
  },
  "files": [
    "dist",
    "docs/guide.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run clean && tsgo -p tsconfig.json && bun scripts/fix-declaration-imports.ts && bun build src/index.ts --outfile=dist/index.js --target=node --format=esm",
    "check": "bun run scripts:check && bun run generate:check && bun run build && bun run package:check && bun run package:consumer-check && bun test ./test && bun run example:check",
    "clean": "rm -rf dist",
    "example:check": "bun build examples/quickstart.ts --target=node --outfile=/tmp/affinity-typescript-quickstart.js && tsgo --noEmit -p examples/tsconfig.json",
    "format": "oxfmt .",
    "generate": "bash scripts/generate.sh",
    "generate:check": "bash scripts/generate-check.sh",
    "package:check": "node scripts/check-package.mjs",
    "scripts:check": "tsgo -p tsconfig.scripts.json",
    "package:consumer-check": "bun scripts/check-packed-package.ts",
    "pack:dry-run": "bun pm pack --dry-run",
    "prepublishOnly": "bun run check"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "26.0.1",
    "@typescript/native-preview": "^7.0.0-dev.20260527.2",
    "oxfmt": "^0.52.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.4.1"
}
