{
  "name": "@affinity-health/sdk",
  "version": "1.3.0",
  "description": "Official TypeScript SDK for the Affinity API",
  "homepage": "https://docs.joinaffinityai.com/api",
  "bugs": {
    "url": "https://github.com/affinity-health/affinity-typescript/issues"
  },
  "license": "MIT",
  "author": "Affinity API Support <support@joinaffinityai.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/affinity-health/affinity-typescript.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run clean && tsgo -p tsconfig.json && bun build src/index.ts --outfile=dist/index.js --target=node --format=esm",
    "check": "bun run generate:check && bun run build && bun run package:check && bun run package:consumer-check && bun test && bun run example:check",
    "clean": "rm -rf dist",
    "dev": "dev up --cwd .",
    "example:dev": "vite --config examples/tanstack-start/vite.config.ts",
    "example:check": "bun build examples/quickstart.ts --target=node --outfile=/tmp/affinity-typescript-quickstart.js && vite build --config examples/tanstack-start/vite.config.ts && tsgo --noEmit -p examples/tanstack-start/tsconfig.json",
    "format": "oxfmt .",
    "generate": "bash scripts/generate.sh",
    "generate:check": "bash scripts/generate-check.sh",
    "package:check": "node scripts/check-package.mjs",
    "package:consumer-check": "bun scripts/check-packed-package.ts",
    "pack:dry-run": "bun pm pack --dry-run",
    "prepublishOnly": "bun run check"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "2.40.1",
    "@tanstack/react-router": "^1.170.8",
    "@tanstack/react-start": "^1.168.14",
    "@types/bun": "latest",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "^7.0.0-dev.20260527.2",
    "@vitejs/plugin-react": "^5.1.1",
    "oxfmt": "^0.52.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "vite": "^8.1.5"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.12"
}
